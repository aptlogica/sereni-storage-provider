SERVER_PORT=8083
# SERVER_HOST: The host address to bind the server (e.g., localhost, 0.0.0.0)
SERVER_HOST=0.0.0.0
# SERVER_IP: The IP/domain used to construct asset URLs (e.g., localhost, 192.168.1.10, yourdomain.com)
SERVER_IP=localhost
SERVER_SCHEME=http

# Storage Drivers: local, s3, rustfs
STORAGE_DRIVER=local

# Local Storage Configuration
STORAGE_DEV_PATH=./uploads

# AWS Configuration
AWS_REGION=us-east-1
AWS_BUCKET=my-bucket
AWS_ACCESS_KEY=your-access-key
AWS_SECRET_KEY=your-secret-key

# RustFS Configuration (S3-compatible)
RUSTFS_ENDPOINT=http://localhost:9000
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
RUSTFS_BUCKET=my-bucket
RUSTFS_USE_SSL=false

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://example.com
